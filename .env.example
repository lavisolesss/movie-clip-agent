# 複製這個檔案成 .env，再把值改成你自己的。.env 不可以 commit。
# 沒有任何一項需要加引號。

# bot 的密碼（Discord Developer Portal -> Bot -> Reset Token）。絕對不能公開。
DISCORD_TOKEN=

# 要處理的頻道 ID（Discord 開發者模式 -> 右鍵頻道 -> Copy Channel ID）。純數字。
CHANNEL_ID=

# 傳給 claude -p --model 的模型：別名（sonnet、opus、haiku）或完整名稱
CLAUDE_MODEL=sonnet

# 資料資料夾：Excel 紀錄、截圖、log 都放這裡。建議放在專案資料夾之外，例如 C:\Users\你的名字\movie-data
DATA_DIR=
